/*
 * Skeletyl 36 — handwired, 2x nice!nano (nRF52840), BLE split, no TRRS.
 *
 * Shared between skeletyl_handwire_left and skeletyl_handwire_right.
 * Both halves are wired identically as a local 4x5 matrix; the right half
 * shifts itself into the upper half of the logical matrix via `col-offset`
 * in skeletyl_handwire_right.overlay.
 *
 * SPDX-License-Identifier: MIT
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    /*
     * Local 4x5 matrix, identical on both halves.
     *
     * Diodes are wired COLUMN -> SWITCH -> DIODE -> ROW with the black
     * band (cathode) facing the ROW, which is `col2row`.
     *
     * For col2row the columns are driven outputs and the rows are sampled
     * inputs, so the rows carry the pull-downs.
     *
     * Pins are nRF52840 GPIOs, which on a nice!nano are the contiguous
     * D0 and D2..D9 pads:
     *
     *   R0  P0.17  = D2        C0  P0.08  = D0/RX
     *   R1  P0.20  = D3        C1  P1.00  = D6
     *   R2  P0.22  = D4        C2  P0.11  = D7
     *   R3  P0.24  = D5        C3  P1.04  = D8
     *   (R3 is the thumb row)  C4  P1.06  = D9
     */
    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        /* Orange row wires — sampled inputs */
        row-gpios
            = <&gpio0 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;

        /* Black column wires — driven outputs */
        col-gpios
            = <&gpio0  8 GPIO_ACTIVE_HIGH>
            , <&gpio1  0 GPIO_ACTIVE_HIGH>
            , <&gpio0 11 GPIO_ACTIVE_HIGH>
            , <&gpio1  4 GPIO_ACTIVE_HIGH>
            , <&gpio1  6 GPIO_ACTIVE_HIGH>
            ;
    };

    /*
     * Logical split matrix: 4 rows x 10 columns.
     *
     * Left half occupies global columns 0-4, right half 5-9
     * (right overlay sets col-offset = <5>).
     *
     * Physical columns are numbered left-to-right on each half, so:
     *   left   C0 = far-left  (pinky)   ... C4 = far-right (index reach)
     *   right  C0 = far-left  (index reach) ... C4 = far-right (pinky)
     *
     * Thumbs live on row 3 and only occupy the three innermost columns
     * of each half:
     *   left  thumbs = C2, C3, C4   -> global cols 2, 3, 4
     *   right thumbs = C0, C1, C2   -> global cols 5, 6, 7
     *
     * RC(3,0), RC(3,1), RC(3,8) and RC(3,9) are intentionally absent —
     * no switch is wired at those intersections.
     *
     * 10 + 10 + 10 + 6 = 36 positions, each used exactly once.
     */
    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        rows = <4>;
        columns = <10>;

        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)   RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)   RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)   RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
                            RC(3,2) RC(3,3) RC(3,4)   RC(3,5) RC(3,6) RC(3,7)
        >;
    };

    /*
     * Physical key positions, in the same order as `default_transform`'s map.
     * Units are 1/100 of a 1u key. Column stagger mirrors the Skeletyl's
     * splay (middle column highest, pinky lowest) and the thumb cluster is
     * rotated inward.
     *
     * This block is cosmetic: it only drives how the layout is drawn in
     * ZMK Studio / Keymap Editor. It has no effect on scanning or on which
     * physical switch maps to which keymap position.
     */
    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Skeletyl 36";
        kscan = <&kscan0>;
        transform = <&default_transform>;

        keys  //                     w    h     x     y    rot     rx    ry
            = <&key_physical_attrs 100 100     0    34      0      0     0>
            , <&key_physical_attrs 100 100   100    10      0      0     0>
            , <&key_physical_attrs 100 100   200     0      0      0     0>
            , <&key_physical_attrs 100 100   300    10      0      0     0>
            , <&key_physical_attrs 100 100   400    22      0      0     0>
            , <&key_physical_attrs 100 100   700    22      0      0     0>
            , <&key_physical_attrs 100 100   800    10      0      0     0>
            , <&key_physical_attrs 100 100   900     0      0      0     0>
            , <&key_physical_attrs 100 100  1000    10      0      0     0>
            , <&key_physical_attrs 100 100  1100    34      0      0     0>
            , <&key_physical_attrs 100 100     0   134      0      0     0>
            , <&key_physical_attrs 100 100   100   110      0      0     0>
            , <&key_physical_attrs 100 100   200   100      0      0     0>
            , <&key_physical_attrs 100 100   300   110      0      0     0>
            , <&key_physical_attrs 100 100   400   122      0      0     0>
            , <&key_physical_attrs 100 100   700   122      0      0     0>
            , <&key_physical_attrs 100 100   800   110      0      0     0>
            , <&key_physical_attrs 100 100   900   100      0      0     0>
            , <&key_physical_attrs 100 100  1000   110      0      0     0>
            , <&key_physical_attrs 100 100  1100   134      0      0     0>
            , <&key_physical_attrs 100 100     0   234      0      0     0>
            , <&key_physical_attrs 100 100   100   210      0      0     0>
            , <&key_physical_attrs 100 100   200   200      0      0     0>
            , <&key_physical_attrs 100 100   300   210      0      0     0>
            , <&key_physical_attrs 100 100   400   222      0      0     0>
            , <&key_physical_attrs 100 100   700   222      0      0     0>
            , <&key_physical_attrs 100 100   800   210      0      0     0>
            , <&key_physical_attrs 100 100   900   200      0      0     0>
            , <&key_physical_attrs 100 100  1000   210      0      0     0>
            , <&key_physical_attrs 100 100  1100   234      0      0     0>
            /* left thumbs: outer -> inner */
            , <&key_physical_attrs 100 100   230   318      0      0     0>
            , <&key_physical_attrs 100 100   332   330   1500    332   430>
            , <&key_physical_attrs 100 100   432   352   3000    432   452>
            /* right thumbs: inner -> outer */
            , <&key_physical_attrs 100 100   668   352 (-3000)   768   452>
            , <&key_physical_attrs 100 100   768   330 (-1500)   868   430>
            , <&key_physical_attrs 100 100   870   318      0      0     0>
            ;
    };
};
